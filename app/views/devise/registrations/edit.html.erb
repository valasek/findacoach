<div class="min-h-screen p-4 sm:p-6 lg:p-8">
  <div class="mx-auto w-full max-w-5xl">
    <h2 class="text-2xl font-semibold mb-6">Settings</h2>

    <div class="tabs tabs-lift overflow-x-auto">
      <!-- Settings Tab -->
      <%= tag.input type: "radio", name: "profile_tabs", id: "settings_tab", class: "tab", aria: { label: "Profile" }, checked: params[:tab] != "booking" %>
      <div class="tab-content min-h-[850px] rounded-b-lg border-base-300 bg-base-100 p-4 sm:p-6 lg:p-8">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, id: "settings_form", multipart: true }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <div class="space-y-6">
            <%= f.fields_for :user_profile, @profile do |profile_form| %>
              <%= profile_form.hidden_field :id %>
              <!-- Photo -->
              <div class="text-center space-y-3">
                <div class="avatar placeholder mx-auto">
                  <div class="w-24 h-24 bg-neutral text-neutral-content rounded-full overflow-hidden">
                    <% if @profile.photo_attached? %>
                      <%= image_tag @profile.photo, alt: "Profile photo", class: "w-full h-full object-cover" %>
                    <% else %>
                      <img alt="User avatar" src="https://img.daisyui.com/images/stock/photo-1534528741775-53994a69daeb.webp">
                    <% end %>
                  </div>
                </div>
                <div>
                  <label class="form-control w-full">
                    <span class="label-text mb-1 block">Update photo</span>
                    <%= profile_form.file_field :photo, accept: "image/*", class: "file-input file-input-bordered w-full" %>
                  </label>
                </div>
              </div>

              <!-- Full Name -->
              <fieldset class="fieldset w-full">
                <legend class="fieldset-legend">Full name</legend>
                <label class="input w-full">
                  <%= profile_form.text_field :full_name, autocomplete: "full-name", placeholder: @profile.display_name %>
                </label>
              </fieldset>

              <!-- Phone -->
              <fieldset class="fieldset w-full">
                <legend class="fieldset-legend">WhatsApp number</legend>
                <label class="input w-full">
                  <%= profile_form.text_field :phone, autocomplete: "phone" %>
                </label>
              </fieldset>

              <!-- Website -->
              <fieldset class="fieldset w-full">
                <legend class="fieldset-legend">Website</legend>
                <label class="input w-full">
                  <%= profile_form.text_field :website %>
                </label>
              </fieldset>

              <!-- Bio -->
              <fieldset class="fieldset w-full">
                <legend class="fieldset-legend">Your bio</legend>
                <%= profile_form.text_area :bio, placeholder: "Enter your bio", class: "textarea w-full", rows: 4 %>
              </fieldset>

              <!-- Username -->
              <fieldset class="fieldset w-full min-w-0">
                <legend class="fieldset-legend">Username</legend>
                <label class="input w-full min-w-0">
                  <%= profile_form.text_field :username, placeholder: "Enter your username", class: "input w-full min-w-0", autocomplete: "username" %>
                </label>
                <p class="label block min-w-0 whitespace-normal text-sm opacity-70">Your public page: <span class="break-all font-semibold"><%= @profile.full_coach_url(request) %></span></p>
              </fieldset>

            <% end %>

            <div class="pt-4">
              <%= f.submit "Save", class: "btn btn-primary w-full" %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Booking Tab -->
      <%= tag.input type: "radio", name: "profile_tabs", id: "booking_tab", class: "tab", aria: { label: "Booking" }, checked: params[:tab] == "booking" %>
      <div class="tab-content min-h-[850px] rounded-b-lg border-base-300 bg-base-100 p-4 sm:p-6 lg:p-8">
        <%= render "booking_settings/form", booking_setting: @booking_setting %>
      </div>

      <!-- Services Tab -->
      <input type="radio" name="profile_tabs" id="services_tab" class="tab" aria-label="Services">
      <div class="tab-content min-h-[850px] rounded-b-lg border-base-300 bg-base-100 p-4 sm:p-6 lg:p-8">
        <div class="space-y-6">
          <%= render "services/index" %>
        </div>
      </div>

      <!-- Change Password Tab (only show if user doesn't use SSO) -->
      <input type="radio" name="profile_tabs" id="password_tab" class="tab" aria-label="Change Password">
      <% unless current_user.sso_user? %>
        <div class="tab-content min-h-[850px] rounded-b-lg border-base-300 bg-base-100 p-4 sm:p-6 lg:p-8">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, id: "password_form" }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="space-y-6">
              <fieldset class="fieldset w-full">
                <legend class="fieldset-legend">New password</legend>
                <p class="label text-sm opacity-70">(leave blank if you don't want to change it)</p>
                <label class="input w-full">
                  <%= f.password_field :password, autocomplete: "new-password" %>
                </label>
                <% if @minimum_password_length %>
                  <p class="label text-sm opacity-70"><%= @minimum_password_length %> characters minimum</p>
                <% end %>
              </fieldset>

              <fieldset class="fieldset w-full">
                <legend class="fieldset-legend">Confirm new password</legend>
                <label class="input w-full">
                  <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
                </label>
              </fieldset>

              <fieldset class="fieldset w-full">
                <legend class="fieldset-legend">Current Password</legend>
                <p class="label text-sm opacity-70">(required to confirm password change)</p>
                <label class="input w-full">
                  <%= f.password_field :current_password, autocomplete: "current-password" %>
                </label>
              </fieldset>

              <div class="pt-4">
                <%= f.submit "Update Password", class: "btn btn-primary w-full" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- SSO User Message -->
        <div class="tab-content min-h-[850px] rounded-b-lg border-base-300 bg-base-100 p-4 sm:p-6 lg:p-8">
          <div>
            <p class="text-sm">You signed in using SSO (Google, Apple, Facebook, etc.). To change your password, please visit your SSO provider:</p>
            <div class="mt-4 flex flex-wrap gap-2">
              <% current_user.providers.each do |provider| %>
                <% case provider %>
                <% when 'google_oauth2' %>
                  <a href="https://myaccount.google.com/security" target="_blank" class="btn btn-primary">Google Account Security</a>
                <% when 'apple' %>
                  <a href="https://appleid.apple.com/account/manage" target="_blank" class="btn btn-primary">Apple ID Security</a>
                <% when 'facebook' %>
                  <a href="https://www.facebook.com/settings?tab=security" target="_blank" class="btn btn-primary">Facebook Security Settings</a>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Cancel Account Tab -->
      <input type="radio" name="profile_tabs" id="cancel_tab" class="tab" aria-label="Cancel Account">
      <div class="tab-content min-h-[850px] rounded-b-lg border-base-300 bg-base-100 p-4 sm:p-6 lg:p-8">
        <div class="space-y-6">
          <div class="alert alert-warning">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
            <div>
              <h3 class="font-bold mb-2">Warning!</h3>
              <div class="text-xs">This will permanently delete your account and all associated data. This action cannot be undone.</div>
            </div>
          </div>

          <div class="card bg-base-200">
            <div class="card-body p-4">
              <p class="text-sm font-medium mb-2">When you cancel your account:</p>
              <ul class="text-sm space-y-1 list-disc list-inside opacity-80">
                <li>All your data will be permanently deleted</li>
                <li>This action cannot be reversed</li>
              </ul>
              <p>Recommended is to <%= link_to "download", clients_path(format: :xlsx), method: :get, class: "link link-primary" %> your coaching data before canceling.</p>
            </div>
          </div>

          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :delete, id: "cancel_form" }) do |f| %>
            <fieldset class="fieldset w-full">
              <legend class="fieldset-legend">Current Password</legend>
              <p class="label text-sm opacity-70">(required to confirm account cancellation)</p>
              <label class="input w-full">
                <%= f.password_field :current_password, autocomplete: "current-password" %>
              </label>
            </fieldset>

            <div class="pt-4">
              <%= f.submit "Cancel my account", 
                  data: { confirm: "Are you absolutely sure? This action cannot be undone!", turbo_confirm: "Are you absolutely sure? This action cannot be undone!" }, 
                  class: "btn btn-error w-full" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="divider my-6"></div>
    <%= link_to "Back", :back, class: "btn" %>
  </div>
</div>
