<% content_for :title, "Book a session with #{@profile.display_name}" %>

<main class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
  <header class="mb-10 border-b border-base-300 pb-8 text-center">
    <% if @profile.photo.attached? %>
      <div class="avatar mb-4">
        <div class="h-24 w-24 rounded-full sm:h-28 sm:w-28">
          <%= image_tag @profile.photo, alt: @profile.display_name, class: "h-full w-full object-cover" %>
        </div>
      </div>
    <% end %>

    <h1 class="text-3xl font-bold sm:text-4xl"><%= @profile.display_name %></h1>

    <% if @profile.bio.present? %>
      <p class="mx-auto mt-3 max-w-2xl whitespace-pre-line text-base leading-relaxed text-base-content/75"><%= @profile.bio %></p>
    <% end %>

    <% if @profile.website.present? %>
      <%= link_to "Visit website", @profile.website, class: "link link-hover mt-3 inline-block text-sm", target: "_blank", rel: "noopener" %>
    <% end %>
  </header>

  <%= turbo_frame_tag "booking", class: "block" do %>
    <% if @booking_setting&.booking_ready? %>
      <%= render "bookings/form",
            profile: @profile,
            booking_setting: @booking_setting,
            booking_request: @booking_request,
            slots: @slots,
            availability_error: @availability_error %>
    <% else %>
      <section class="py-8 text-center">
        <h2 class="text-2xl font-semibold">Online booking is not available</h2>
        <p class="mt-2 text-base-content/70">This coach is not accepting online booking requests right now.</p>
      </section>
    <% end %>
  <% end %>
</main>
