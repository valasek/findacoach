<% content_for :title, "Editing client" %>

<div class="md:w-2/3 w-full mx-auto">

  <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-3 mb-8">
    <span>
      <%= link_to clients_path, class: "btn btn-square sm:btn-wide" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M8.354 1.646a.5.5 0 0 1 0 .708L2.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
          <path fill-rule="evenodd" d="M12.354 1.646a.5.5 0 0 1 0 .708L6.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
        </svg>
        <span class="hidden sm:inline">Back</span>
      <% end %>
    </span>
    <h1 class="min-w-0 break-words text-right sm:text-center">Editing Client</h1>
  </div>

  <%= render "form", client: @client %>
</div>
