<%= form_with(model: client, class: "block", local: false) do |form| %>
  <%= render "partials/show_form_errors", object: client %>

  <div class="grid grid-cols-1 gap-x-4 md:grid-cols-3">
    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= form.label :name %></legend>
      <%= form.text_field :name, autofocus: true, placeholder: "Name", class: ["input w-full text-base-content", {"input-error": client.errors[:name].any?}] %>
    </fieldset>
    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= form.label :email %></legend>
      <%= form.email_field :email, placeholder: "Email", class: ["input w-full text-base-content", {"input-error": client.errors[:email].any?}] %>
    </fieldset>
    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= form.label :phone %></legend>
      <%= form.telephone_field :phone, placeholder: "Phone", class: ["input w-full text-base-content", {"input-error": client.errors[:phone].any?}] %>
    </fieldset>
  </div>

  <div class="mb-8">
    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend"><%= form.label :notes %></legend>
      <%= form.text_area :notes, rows: 8, placeholder: "Notes", class: "textarea w-full text-base-content" %>
    </fieldset>
  </div>

  <%= form.submit "Save", class: "btn btn-primary w-full sm:w-auto" %>
<% end %>
