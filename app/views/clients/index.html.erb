<div class="md:w-2/3 w-full mx-auto">
  <% content_for :title, "Clients" %>

  <div class="grid grid-cols-1 items-center gap-4 mb-6 lg:grid-cols-[1fr_auto_1fr]">
    <div class="order-2 flex w-full items-center gap-3 lg:order-1 lg:w-auto">
      <%= link_to new_client_path, class: "btn btn-primary" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        New client
      <% end %>
      <div class="badge badge-outline">
        Total: <%= @clients_count %>
      </div>
    </div>

    <h1 class="order-1 text-base-content lg:order-2 lg:text-center">Clients</h1>

    <div class="order-3 w-full lg:min-w-80 lg:justify-self-end">
      <%= form_with url: clients_path, method: :get, class: "w-full", data: { controller: "search-client", turbo_frame: "clients-list" } do |f| %>
        <%= f.text_field :query,
                        value: params[:query],
                        placeholder: "Search by name or email...",
                        class: "input input-bordered w-full text-base-content",
                        data: {
                            action: "input->search-client#search",
                            search_client_target: "input"
                        } %>
      <% end %>
    </div>
  </div>

  <div id="clients">
    <%= turbo_frame_tag "clients-list" do %>
      <% if @clients.any? %>
        <div class="flex flex-row justify-center items-center mt-0 mb-4">
          <p class="text-base-content"><%= page_entries_info @clients %></p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
          <% @clients.each do |client| %>
            <%= render "client_card", client: client, sessions: client.sessions %>
          <% end %>
        </div>
        <div class="flex flex-row justify-center items-center my-8">
          <p class="text-base-content"><%= paginate @clients %></p>
        </div>
      <% else %>
        <% if params[:query].present? %>
          <!-- No clients found from search, but clients exist in the system -->
          <div class="hero min-h-96">
            <div class="hero-content text-center">
              <div class="max-w-md">
                <p class="text-lg mb-6 text-base-content">No such client</p>
                <p class="text-sm text-base-content/70 mb-6">
                  Try adjusting your search terms.
                </p>
              </div>
            </div>
          </div>
        <% elsif @clients_count == 0 %>
          <!-- No clients exist in the system at all -->
          <div class="hero min-h-96">
            <div class="hero-content text-center">
              <div class="max-w-md">
                <p class="text-lg mb-6 text-base-content">No clients have been created<br>Why not to create one?</p>
              </div>
            </div>
          </div>
        <% else %>
          <!-- Edge case: clients exist but none returned (shouldn't normally happen) -->
          <div class="hero min-h-96">
            <div class="hero-content text-center">
              <div class="max-w-md">
                <p class="text-lg mb-6 text-base-content">No clients to display</p>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
