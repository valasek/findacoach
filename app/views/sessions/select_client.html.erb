<% content_for :title, "New session" %>

<div class="md:w-2/3 w-full mx-auto">

  <div class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-3 mb-8">
    <span>
      <%= link_to findacoach_dashboard_path, class: "btn btn-square sm:btn-wide" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M8.354 1.646a.5.5 0 0 1 0 .708L2.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/>
          <path fill-rule="evenodd" d="M12.354 1.646a.5.5 0 0 1 0 .708L6.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/>
        </svg>
        <span class="hidden sm:inline">Back</span>
      <% end %>
    </span>
    <h1 class="min-w-0 break-words text-right sm:text-center">New Session</h1>
  </div>

  <p class="text-center text-base-content mb-4">Pick a client to log the session for</p>

  <div class="w-full md:w-96 mx-auto mb-8">
    <%= form_with url: start_session_path, method: :get, class: "w-full", data: { controller: "search-client", turbo_frame: "session-clients-list" } do |f| %>
      <%= f.text_field :query,
                      value: params[:query],
                      autofocus: true,
                      placeholder: "Search by name or email...",
                      class: "input input-bordered w-full text-base-content",
                      data: {
                          action: "input->search-client#search",
                          search_client_target: "input"
                      } %>
    <% end %>
  </div>

  <%= turbo_frame_tag "session-clients-list" do %>
    <% if @clients.any? %>
      <div class="flex flex-col gap-2">
        <% @clients.each do |client| %>
          <%= link_to new_client_session_path(client, source: "select_client"), class: "btn btn-block btn-outline min-w-0 justify-between gap-3", data: { turbo_frame: "_top" } do %>
            <span class="min-w-0 flex-1 truncate text-left"><%= client.name %></span>
            <span class="max-w-1/2 truncate text-xs font-normal text-base-content/70"><%= client.email %></span>
          <% end %>
        <% end %>
      </div>
      <div class="flex flex-row justify-center items-center my-8">
        <p class="text-base-content"><%= paginate @clients %></p>
      </div>
    <% else %>
      <div class="hero min-h-48">
        <div class="hero-content text-center">
          <div class="max-w-md">
            <% if params[:query].present? %>
              <p class="text-lg mb-2 text-base-content">No such client</p>
              <p class="text-sm text-base-content/70 mb-6">Try adjusting your search terms.</p>
            <% else %>
              <p class="text-lg mb-6 text-base-content">No clients have been created<br>Why not to create one?</p>
            <% end %>
            <%= link_to "New client", new_client_path, class: "btn btn-primary", data: { turbo_frame: "_top" } %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
