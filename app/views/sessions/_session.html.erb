<div id="<%= dom_id session %>" class="grid grid-cols-1 gap-x-4 sm:grid-cols-3">
    <fieldset class="fieldset min-w-0">
        <legend class="fieldset-legend">Duration</legend><%= session.duration %> h
    </fieldset>
    <fieldset class="fieldset min-w-0">
        <legend class="fieldset-legend">Service</legend><%= session.service.name %>
    </fieldset>
    <fieldset class="fieldset min-w-0">
        <legend class="fieldset-legend">Type</legend>
        <% if session.group? %>
            Group, <%= session.group_size %> members
        <% else %>
          <div class="stat-desc">Individual</div>
        <% end %>
    </fieldset>
</div>

<div class="mb-8">
    <fieldset class="fieldset min-w-0">
        <legend class="fieldset-legend">Notes</legend><%= session.notes %>
  </fieldset>
</div>
